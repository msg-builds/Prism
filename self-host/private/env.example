# Copy to .env (mode 600). Never commit the filled-in file.
PRISM_IMAGE=prism:2.51.0-<commit>
PRISM_PORT=3130
MAILPIT_PORT=3131
SERVER_URL=http://127.0.0.1:3130

# openssl rand -base64 32 for each
APP_SECRET=
ENCRYPTION_KEY=
PG_PASSWORD=

# Shared platform cluster instead of the bundled db service:
# PG_HOST= PG_PORT= PG_DATABASE=prism

# STORAGE_TYPE=s3 with the prism-files bucket once it exists:
# STORAGE_S3_REGION= STORAGE_S3_NAME=prism-files STORAGE_S3_ENDPOINT=
# STORAGE_S3_ACCESS_KEY_ID= STORAGE_S3_SECRET_ACCESS_KEY=

EMAIL_FROM_NAME=Nebula
EMAIL_FROM_ADDRESS=
# Real delivery: point these at the chosen SMTP provider instead of mailpit
# EMAIL_SMTP_HOST= EMAIL_SMTP_PORT=587 EMAIL_SMTP_NO_TLS=false EMAIL_SMTP_USER= EMAIL_SMTP_PASSWORD=
